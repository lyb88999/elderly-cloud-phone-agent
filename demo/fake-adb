#!/usr/bin/env python3
"""模拟 adb：假装是一台连着的安卓手机，供 demo 和测试用。

只实现 ADBCloudPhone 用到的那几个子命令：
devices / shell uiautomator dump / shell cat / shell input tap /
shell monkey / shell wm size / shell echo ok / exec-out screencap -p。

手机状态（当前在哪个应用、点过哪里）存在 /tmp/elderly-agent-fake-phone.json。
"""
import base64
import json
import os
import sys

STATE_PATH = "/tmp/elderly-agent-fake-phone.json"
FIXTURES = os.path.join(os.path.dirname(os.path.abspath(__file__)), "fixtures")

# 1x1 白色 PNG，screencap 就返回它
PNG_1X1 = base64.b64decode(
    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
)

KNOWN_APPS = {
    "com.tencent.mm": "wechat",
    "com.eg.android.AlipayGphone": "alipay",
    "com.android.dialer": "dialer",
    "com.android.camera": "camera",
}


def load_state():
    try:
        with open(STATE_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"app": "desktop", "taps": []}


def save_state(state):
    with open(STATE_PATH, "w", encoding="utf-8") as f:
        json.dump(state, f)


def dump_for(app):
    path = os.path.join(FIXTURES, f"{app}_dump.xml")
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    # 没准备 fixture 的应用：现场拼一个最小的 dump
    package = app
    return (
        "<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>\n"
        "<hierarchy rotation=\"0\">\n"
        f"  <node index=\"0\" text=\"{package}\" resource-id=\"\" class=\"android.widget.TextView\" "
        f"package=\"{package}\" content-desc=\"{package}主界面\" clickable=\"true\" "
        "bounds=\"[0,0][1080,1920]\" />\n"
        "</hierarchy>\n"
    )


def main(argv):
    # 去掉 -s <serial>
    args = []
    i = 0
    while i < len(argv):
        if argv[i] == "-s":
            i += 2
            continue
        args.append(argv[i])
        i += 1
    if not args:
        print("fake-adb: 缺少子命令", file=sys.stderr)
        return 1

    state = load_state()
    cmd = args[0]

    if cmd == "devices":
        print("List of devices attached")
        print("fake-phone-001\tdevice")
        return 0

    if cmd == "shell":
        rest = args[1:]
        if rest[:2] == ["uiautomator", "dump"]:
            print("UI hierchary dumped to: /sdcard/window_dump.xml")
            return 0
        if rest[:2] == ["cat", "/sdcard/window_dump.xml"]:
            sys.stdout.write(dump_for(state["app"]))
            return 0
        if rest[:2] == ["input", "tap"]:
            state["taps"].append([int(rest[2]), int(rest[3])])
            save_state(state)
            return 0
        if rest[0] == "monkey":
            # monkey -p <package> -c android.intent.category.LAUNCHER 1
            pkg = rest[rest.index("-p") + 1]
            state["app"] = KNOWN_APPS.get(pkg, pkg)
            save_state(state)
            print("Events injected: 1")
            print("## Network stats: elapsed time=10ms")
            return 0
        if rest[:2] == ["wm", "size"]:
            print("Physical size: 1080x1920")
            return 0
        if rest[:2] == ["echo", "ok"]:
            print("ok")
            return 0
        print(f"fake-adb: 不支持的 shell 命令：{' '.join(rest)}", file=sys.stderr)
        return 1

    if cmd == "exec-out":
        if args[1:] == ["screencap", "-p"]:
            sys.stdout.buffer.write(PNG_1X1)
            sys.stdout.buffer.flush()
            return 0
        print(f"fake-adb: 不支持的 exec-out 命令：{' '.join(args[1:])}", file=sys.stderr)
        return 1

    print(f"fake-adb: 不支持的命令：{' '.join(args)}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
